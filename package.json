{
  "name": "veylix",
  "version": "0.1.0",
  "description": "Developer-focused dependency health and risk prioritization platform",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && tsc -p tsconfig.server.json && node scripts/generate-seo-files.mjs",
    "build:engine": "tsc",
    "build:ui": "vite build",
    "preview": "vite preview",
    "start": "node server-dist/server/production-server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:live": "vitest run --config vitest.live.config.ts"
  },
  "devDependencies": {
    "vitest": "^4.1.12"
  },
  "dependencies": {
    "@types/node": "^22.13.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.3.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^5.7.3",
    "vite": "^6.4.5"
  },
  "engines": {
    "node": ">=20"
  }
}
